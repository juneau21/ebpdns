[Unit]
Description=Daily restart ebpdns at 04:30 (low-traffic window, memory hygiene)
Documentation=file:///opt/ebpdns/README.md

[Timer]
# 每天 04:30 本地时间触发; Persistent=true 确保错过的时间点开机后补跑
OnCalendar=*-*-* 04:30:00
Persistent=true
# 随机延迟 0-300s, 避免多台机器同时重启造成 DNS 抖动
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
