[Unit]
Description=ebpdns - eBPF SmartDNS-style DNS resolver
Documentation=file:///opt/ebpdns/README.md
After=network-online.target
Wants=network-online.target
# 崩溃循环保护: 60s 内最多 5 次启动, 超过则 systemd 进入 failed 不再自动重启,
# 避免配置坏/依赖缺失时服务疯狂重启打满 CPU 与 journald。
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# v1.9.83: 内存优化环境变量组合(glibc 方案)
#   PYTHONMALLOC=malloc     — Python 直接用系统 malloc(而非 pymalloc arena), free() 后内存可归还 OS
#   MALLOC_ARENA_MAX=2      — 压住多线程 arena 分裂(123 Tasks 下关键), 验证对 QPS 无影响
#   MALLOC_MMAP_THRESHOLD_  — 固定 mmap 阈值, 防止动态调整让 TRIM_THRESHOLD 失效
#   MALLOC_TRIM_THRESHOLD_  — free 时自动收缩 top region, 减少对定时 trim 的依赖
# 配合 cli.py 每 5min 相对阈值触发的 malloc_trim(0)(已去掉 gc.collect, 因 88ms STW 且回收 0 对象),
# 长期运行 RSS 可降 30-50%。
#
# --- Plan B: jemalloc(若 glibc 方案下 trim 有尖刺或 sys CPU 升高) ---
# 安装: apt install libjemalloc2
# 切换: 注释掉上面 4 个 MALLOC_* 变量, 改用以下 3 行:
#   Environment=LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2
#   Environment=PYTHONMALLOC=malloc
#   Environment=MALLOC_CONF=background_thread:true,dirty_decay_ms:5000,muzzy_decay_ms:5000
# jemalloc 自动 decay 无需手动 trim, cli.py 的 _trim_loop 会通过 mallctl 探针自动跳过。
Environment=PYTHONMALLOC=malloc
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_MMAP_THRESHOLD_=131072
Environment=MALLOC_TRIM_THRESHOLD_=131072
# 内存兜底: 超过 1G 触发回收压力, 超过 1.5G 被 OOM killer 选中(防止整机拖垮)
MemoryHigh=1G
MemoryMax=1.5G
# 以专用系统用户 ebpdns 运行(install.sh 创建, nologin)。配合下方 AmbientCapabilities
# 仅授予 CAP_NET_BIND_SERVICE 绑定 53 端口; /etc/ebpdns 由 install.sh 置为 ebpdns:ebpdns
# 750, 服务可读写配置/缓存, 代码目录 /opt/ebpdns 保持 root:root 只读。此前 User=root 使
# 下方整套沙箱硬化(ProtectSystem=strict/NoNewPrivileges/...)失去降权意义。
User=ebpdns
Group=ebpdns
ExecStart=/opt/ebpdns/bin/ebpdns run --config /etc/ebpdns/config.json
Restart=on-failure
RestartSec=5
# 优雅退出: SIGTERM 后 15s 内未退出则 SIGKILL。
# P2-2(R4 审查): 原 5s 在大 cache.json(cache_size=131072 热点条目多时数 MB)落盘时偏紧——
# SIGTERM 钩子要停 socket、等在途解析、把内存 LRU 原子落盘(tmp+fsync+rename)、join
# 连接池/QUIC 线程。5s 被 SIGKILL 会丢失本次内存最新缓存条目(重启后从旧 cache.json 恢复,
# 预热窗口变长)并泄漏上游 TCP 连接。15s 窗口对每日 04:30 低峰维护可接受; DNS 秒退诉求
# 由 RestartSec=5 兜底(新实例仍在旧实例完全退出后才 bind 53)。
KillSignal=SIGTERM
TimeoutStopSec=15
# v7 P2-3: 安全沙箱硬化。
#   仅保留绑 53 端口与 eBPF 所需的最小能力集; 移除多余能力收敛攻击面。
# v1.9.158 §8: eBPF 内核态缓存(kernel_cache=true)由本 Python 守护进程内直接经
#   bpf(2)/libbpf(ctypes) 加载 map/prog 并 attach XDP, 需要:
#     CAP_BPF         — bpf(BPF_MAP_CREATE/PROG_LOAD) 创建 LRU_HASH map 与加载 XDP prog
#     CAP_NET_ADMIN   — 把 XDP prog attach 到指定网卡
#     CAP_SYS_ADMIN   — bpftool/libbpf 部分辅助路径(pin map 等)
#     CAP_IPC_LOCK    — 提升 memlock 限额以便锁定较大 LRU map(配合下方 LimitMEMLOCK=infinity);
#                       未启用 kernel_cache 时这些能力不被实际消耗, 攻击面不变。
#   仅当启用 kernel_cache 时实际使用; 未启用时攻击面不变。
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN CAP_SYS_ADMIN CAP_IPC_LOCK
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN CAP_SYS_ADMIN CAP_IPC_LOCK
# v1.9.158: eBPF LRU_HASH map(kernel_cache_max 可达 1048576 条 × ~151B ≈ 150MB)需锁定
# 内存不被 swap/回收。默认 memlock 限制(通常 64KB)会让 BPF_MAP_CREATE 报 ENOMEM, 故放开到
# infinity(与 CAP_IPC_LOCK 配套; 未启用 eBPF 时此限额无副作用)。
LimitMEMLOCK=infinity
# v1.9.161 审查文档化(不放宽沙箱): 在本 service 的硬化组合下, bpf_loader 的
# **bpftool CLI 兜底路径不可用**, 内核缓存(kernel_cache=true)仅在 **libbpf.so.0
# 可用**(install.sh 已确保安装 libbpf 运行库)时生效:
#   - ProtectSystem=strict(仅 ReadWritePaths=/etc/ebpdns)使 bpftool 无法在
#     /sys/fs/bpf 下 mkdir/pin  map(prog), pin 路径创建即 EPERM/EROFS。
#   - RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX **不含 AF_NETLINK**,
#     bpftool 兜底用的 `ip link set dev X xdpgeneric`(netlink RTM_SETLINK)
#     会 EAFNOSUPPORT, 无法 attach XDP。
# 安全优先: 不为了让 bpftool 兜底工作而去加 AF_NETLINK 或放宽 ProtectSystem
# (那会扩大攻击面)。因此部署前提是宿主机装有 libbpf.so.0(ctypes 直调 bpf(2)/
# libbpf_open_object), 该路径经 CAP_BPF/CAP_NET_ADMIN 即可, 不依赖 netlink 也不写
# /sys/fs/bpf。若 libbpf 缺失, bpf_loader 会优雅降级为纯用户态(打 WARNING),
# DNS 服务不受影响, 仅失去内核态直答加速。
# v7 P2-3: 沙箱硬化
NoNewPrivileges=yes
# P3-7(第七轮审查): 由 full 收紧为 strict。/etc 整体只读, 仅 ReadWritePaths=/etc/ebpdns
# 显式放行写配置; /var/log 由 journald 接管(stdout/stderr), /tmp 由 PrivateTmp 私有,
# 无其它运行时写路径, 故可安全 strict(攻击面更小, 整个文件系统根只读)。
ProtectSystem=strict
# P3-4(第八轮): ProtectSystem=full 使 /etc 只读, 但 save_config 需写 /etc/ebpdns。
# 显式放行该目录(保留 /etc 其余路径只读), 避免原子写 tmp+rename 失败后兜底直写也失败。
ReadWritePaths=/etc/ebpdns
ProtectHome=yes
PrivateTmp=yes
UMask=0027
LimitNOFILE=65536
# P1-11(第九轮审查): 追加 7 项安全沙箱硬化。
#   PrivateDevices: 私有 /dev, 隐藏物理块设备/字符设备, 防意外直写磁盘。
#   ProtectKernelTunables: 屏蔽 /proc/sys 等内核可调参数(只读), 防运行时改 sysctl。
#   ProtectControlGroups: 屏蔽 cgroup 树写入, 防服务篡改自身/兄弟进程 cgroup。
#   RestrictAddressFamilies: 只允许 AF_INET(IPv4)/AF_INET6(IPv6)/AF_UNIX(本地 socket)。
#     DNS 守护进程只需 UDP/TCP 监听与 DoH/DoQ 上游连接, 无需 AF_NETLINK/AF_PACKET。
#     P2-3(R2 审查): 已 grep ebpdns/*.py 确认未调用 socket.getifaddrs() / AF_NETLINK /
#     if_nameindex / AF_PACKET / SOCK_RAW(全部 socket.socket() 均按地址族选 AF_INET/AF_INET6,
#     DoH/DoT 走 TLS wrap_socket)。因此不加 AF_NETLINK, 维持最小攻击面。
#     若后续 bpf_loader 或自动枚举网卡功能加入, 启动报 EAFNOSUPPORT 时再补 AF_NETLINK。
#   RestrictRealtime: 禁止 Realtime 调度策略(SCHED_FIFO/RR), 防 CPU 饥饿攻击面。
#   RestrictSUIDSGID: 禁止 setuid/setgid 文件生效, 提权面收敛。
#   LockPersonality: 锁定进程 personality(防止修改 Linux x86 执行域, 如 vm86 漏洞面)。
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# P3-4(R3 修复): 追加 3 项硬化。
#   RestrictNamespaces: 禁止创建新 namespace(unshare/CLONE_NEW*), 收敛容器逃逸面。
#     本服务为单进程 DNS 解析器, 不调用 unshare; 若未来引入需 namespace 的功能(如隔离子进程),
#     启动报 EOPNOTSUPP/EPERM 时再放开。
#   ProtectKernelModules: 禁止加载/卸载内核模块(init_module/finit_module/delete_module)。
#     v1.9.158: eBPF 虽由本守护进程经 bpf(2)/libbpf 加载, 但走的是 BPF_PROG_LOAD 等
#     bpf() 系统调用(受 CAP_BPF 管控), 并非 init_module 内核模块加载, 故仍可安全禁止;
#     仅当未来改用 insmod/modprobe 加载内核模块形式的 XDP 驱动时才需移除此项。
#   ProtectProc=invisible + ProcSubset=pid: 隐藏 /proc 下其他进程(仅见自身及 pid 子集),
#     防其他进程信息泄露; /proc/self 仍可读(内存探针/trim 线程需要)。
RestrictNamespaces=yes
ProtectKernelModules=yes
ProtectProc=invisible
ProcSubset=pid
# P2-1(第七轮审查): 禁止任何可写内存段同时可执行(W^X)。
#   纯 CPython 无 JIT, ctypes/OpenSSL(aioquic/ssl)/aioquic 均用"先 mmap 写、再 mprotect
#   改只读/可执行"的两段式落位(先 RW 再 RX), 不存在运行时 W+X 页, 不触发该拒绝。
# P3-2(第八轮审查): 运行时冒烟记录。上述两段式 mprotect 路径已静态核对; 上线后建议首次
#   拉起一次 DoH3/DoQ 上游(经 aioquic/openssl 的 quic TLS 握手)做运行时冒烟验证, 确认
#   mprotect(..., PROT_EXEC) 在本内核/glibc 组合下不报 EPERM。若未来引入 JIT 组件(PyPy/
#   Cython 运行时生成代码/扩展模块自改可执行页)需移除此行, 否则启动即 EPERM/段错误。
MemoryDenyWriteExecute=yes
# P3-10(R12): 补两条零副作用纵深硬化。
#   ProtectClock: 禁止调用 settimeofday/clock_settime/adjtime 改系统时钟。ebpdns 纯 CPython
#     DNS 解析器, 只 time.time() 读时钟, 从不写; 禁掉收敛"被利用改系统时间影响日志/缓存TTL语义"的攻击面。
#     (未来若引入 NTP 校准/写系统时间功能需移除此项。)
#   ProtectHostname: 禁止调用 sethostname 改主机名。服务无主机名需求, 收敛容器/主机名伪造面。
ProtectClock=yes
ProtectHostname=yes

[Install]
WantedBy=multi-user.target
