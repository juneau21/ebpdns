#!/usr/bin/env python3
"""ebpdns 启动入口（项目内直跑）。安装后位于 /opt/ebpdns/bin/ebpdns，
systemd unit 直接以绝对路径调用（ExecStart=/opt/ebpdns/bin/ebpdns run ...）。"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
from ebpdns.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
